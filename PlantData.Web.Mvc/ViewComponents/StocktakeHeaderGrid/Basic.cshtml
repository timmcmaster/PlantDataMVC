@using StocktakeHeader = PlantData.Web.Mvc.Models.ViewModels.StocktakeHeader

@model StocktakeHeaderGridViewModel
@{
    StocktakeHeader.StocktakeHeaderListViewModel sampleElement = new StocktakeHeader.StocktakeHeaderListViewModel();
}
<div class="container-lg">
    @if (Model.Options.AllowAdd)
    {
        <a asp-controller="@PlantDataMvcAppControllers.StocktakeHeader" asp-action="New">Add New Item</a>
    }
    <table class="table border">
        <thead>
            <tr>
                <th scope="col">@Html.ColumnHeaderFor(m => sampleElement.Reference, Model.Options.AllowSorting)</th>
                <th scope="col">@Html.ColumnHeaderFor(m => sampleElement.StocktakeDate, Model.Options.AllowSorting)</th>
                @if (Model.Options.AllowEdit)
                {
                    <th scope="col"></th>
                }
                @if (Model.Options.AllowDelete)
                {
                    <th scope="col"></th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                int count = 0;
                foreach (var entry in Model.Items)
                {
                    <tr>
                        <td><a asp-controller=@PlantDataMvcAppControllers.StocktakeHeader asp-action="Show" asp-route-id="@entry.Id">@entry.Reference</a></td>
                        <td>@Html.DisplayFor(m => m.Items.ElementAt(count).StocktakeDate)</td>
                        @if (Model.Options.AllowEdit)
                        {
                            <td><a asp-controller=@PlantDataMvcAppControllers.StocktakeHeader asp-action="Edit" asp-route-id="@entry.Id">Edit</a></td>
                        }
                        @if (Model.Options.AllowDelete)
                        {
                            <td><a asp-controller=@PlantDataMvcAppControllers.StocktakeHeader asp-action="Delete" asp-route-id="@entry.Id">Delete</a></td>
                        }
                    </tr>
                    count++;
                }
            }
        </tbody>
    </table>
    @if (Model.Options.AllowPaging)
    {
        @Html.PagingLinksFor(m => Model)
    }
</div>