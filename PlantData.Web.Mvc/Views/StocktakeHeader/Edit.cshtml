@model PlantData.Web.Mvc.Models.ViewModels.StocktakeHeader.StocktakeHeaderEditViewModel
@{
    ViewBag.Title = "Edit";
}
<h2>Edit</h2>
<div class="container-lg">
    <form asp-controller=@PlantDataMvcAppControllers.StocktakeHeader asp-action="Update">
        <div asp-validation-summary="ModelOnly"></div>
        <fieldset>
            <legend>StocktakeHeader</legend>

            <input asp-for="Id" type="hidden" />

            <div class="row mb-3">
                <label asp-for="Reference" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="Reference" class="form-control" />
                    <span asp-validation-for="Reference"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="StocktakeDate" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="StocktakeDate" class="form-control" />
                    <span asp-validation-for="StocktakeDate"></span>
                </div>
            </div>

            <p>
                <input type="submit" value="Update" />
            </p>
        </fieldset>
    </form>

    <!-- This is the div that will contain the map -->
    <div id="map" class="map"><div id="popup"></div></div>

    <div>
        <a asp-controller=@PlantDataMvcAppControllers.StocktakeHeader asp-action="Index">Back to Index</a>
    </div>
</div>
