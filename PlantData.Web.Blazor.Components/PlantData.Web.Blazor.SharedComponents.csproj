<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Grid\BasicGrid\**" />
    <Compile Remove="Grid\PrettyGrid\**" />
    <Content Remove="Grid\BasicGrid\**" />
    <Content Remove="Grid\PrettyGrid\**" />
    <EmbeddedResource Remove="Grid\BasicGrid\**" />
    <EmbeddedResource Remove="Grid\PrettyGrid\**" />
    <None Remove="Grid\BasicGrid\**" />
    <None Remove="Grid\PrettyGrid\**" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Syncfusion.Blazor" Version="28.1.41" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlantData.Web.Blazor.ViewModels\PlantData.Web.Blazor.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Grid\GridWrapper.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
