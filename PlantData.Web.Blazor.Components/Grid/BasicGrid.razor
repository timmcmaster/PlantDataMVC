@using Microsoft.AspNetCore.Components.Routing
@attribute [CascadingTypeParameter(nameof(TRowData))]
@typeparam TRowData

<CascadingValue IsFixed="true" Value="this">
    @GridColumns
</CascadingValue>

@* Render the grid *@
<div class="container-lg">
    @if (AllowAdd)
    {
        <NavLink href="@($"{Links.AddNew}")">Add New Item</NavLink>
    }
    <table class="table border">
        <thead>
            <tr>
                @*<th scope="col">@Html.ColumnHeaderFor(m => sampleElement.LatinName, ViewModel.Options.AllowSorting)</th> *@
                @foreach (var column in columns)
                {
                    @column.HeaderTemplate;
                }
                <th scope="col"></th>
                @if (AllowEdit)
                {
                    <th scope="col"></th>
                }
                @if (AllowDelete)
                {
                    <th scope="col"></th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                int count = 0; 
                @foreach (var entry in Items)
                {
                    <tr @key="entry.GetHashCode()">

                        @foreach (var column in columns)
                        {
                            @column.CellTemplate(entry);
                        }
                        <NavLink href="@($"{Links.Show}")">Show</NavLink>
                        @if (AllowEdit)
                        {
                            <NavLink href="@($"{Links.Edit}")">Edit</NavLink>
                        }
                        @if (AllowDelete)
                        {
                            <NavLink href="@($"{Links.Delete}")">Delete</NavLink>
                        }
                    </tr>
                    count++;
                }
            }
        </tbody>
    </table>
    @if (AllowPaging)
    {
        @* @Html.PagingLinksFor(m => Model) *@
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required IEnumerable<TRowData> Items { get; set; }

    [Parameter]
    public bool AllowAdd { get; set; }

    [Parameter]
    public bool AllowEdit { get; set; }

    [Parameter]
    public bool AllowDelete { get; set; }

    [Parameter]
    public bool AllowPaging { get; set; }

    [Parameter]
    public GridLinksModel Links { get; set; }

    [Parameter]
    public RenderFragment? GridColumns { get; set; } = default!; // Should contain all columns

    private readonly List<BasicGridColumn<TRowData>> columns = new List<BasicGridColumn<TRowData>>();

    
    internal void AddColumn(BasicGridColumn<TRowData> column)
    {
        columns.Add(column);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // The first render will instantiate the BasicGridColumn defined in the ChildContent.
            // BasicGridColumn calls AddColumn during its initialization. This means that until
            // the first render is completed, the columns collection is empty.
            // Calling StateHasChanged() will re-render the component, so the second time it will know the columns
            StateHasChanged();
        }
    }
}
