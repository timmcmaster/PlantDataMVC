@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@typeparam TRowData

@code {
    [CascadingParameter]
    public required BasicGrid<TRowData> Parent { get; set; }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    /// <summary>
    /// The URL data source configuration pointing to the grid controller.
    /// </summary>
    [Parameter, EditorRequired]
    public required GridUrlDataSourceModel UrlDataSource { get; set; }

    /// <summary>
    /// Paging configuration.
    /// </summary>
    [Parameter]
    public PagingModel? Paging { get; set; }

    /// <summary>
    /// Sorting configuration.
    /// </summary>
    [Parameter]
    public GridSortingModel? Sorting { get; set; }

    /// <summary>
    /// Whether paging is enabled.
    /// </summary>
    [Parameter]
    public bool AllowPaging { get; set; }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        Parent.SetDataManager(this);
        await ReadAsync();
    }

    /// <summary>
    /// Reads/refreshes data from the grid controller.
    /// </summary>
    public async Task ReadAsync()
    {
        var skip = Paging is not null ? (Paging.PageNumber - 1) * Paging.PageSize : 0;
        var take = Paging?.PageSize ?? 20;

        var sortedList = new List<object>();
        if (Sorting is not null && !string.IsNullOrEmpty(Sorting.SortBy))
        {
            sortedList.Add(new
            {
                name = Sorting.SortBy,
                direction = Sorting.SortAscending ? "ascending" : "descending"
            });
        }

        var request = new
        {
            skip,
            take,
            requiresCounts = true,
            sorted = sortedList,
            @params = new Dictionary<string, object>
            {
                { "allowPaging", AllowPaging }
            }
        };

        var response = await Http.PostAsJsonAsync(UrlDataSource.Url, request);
        response.EnsureSuccessStatusCode();

        var content = await response.Content.ReadFromJsonAsync<DataManagerResponse>(JsonOptions);

        if (content?.Result is not null)
        {
            Parent.SetItems(content.Result, content.Count);
        }
    }

    /// <summary>
    /// Inserts a new item via the grid controller.
    /// </summary>
    public async Task InsertAsync(TRowData item)
    {
        var payload = new { value = item };
        var response = await Http.PostAsJsonAsync(UrlDataSource.InsertUrl, payload);
        response.EnsureSuccessStatusCode();
        await ReadAsync();
    }

    /// <summary>
    /// Updates an existing item via the grid controller.
    /// </summary>
    public async Task UpdateAsync(TRowData item)
    {
        var payload = new { value = item };
        var response = await Http.PostAsJsonAsync(UrlDataSource.UpdateUrl, payload);
        response.EnsureSuccessStatusCode();
        await ReadAsync();
    }

    /// <summary>
    /// Deletes an item via the grid controller by key.
    /// </summary>
    public async Task DeleteAsync(object key)
    {
        var payload = new { key };
        var response = await Http.PostAsJsonAsync(UrlDataSource.DeleteUrl, payload);
        response.EnsureSuccessStatusCode();
        await ReadAsync();
    }

    private class DataManagerResponse
    {
        public List<TRowData>? Result { get; set; }
        public int Count { get; set; }
    }
}
