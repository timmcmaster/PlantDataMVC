@using Microsoft.AspNetCore.Components.QuickGrid
@using PlantData.Web.Blazor.SharedComponents.Grid
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using System;
@using System.Linq.Expressions;
@using System.Reflection;

@typeparam TGridItem
@typeparam TForeignDataItem


<div class="container-lg">
    @if (@GridType == GridType.Basic)
    {
        @* No special behaviour (yet) for basic column *@
        <BasicGridColumn TRowData="TGridItem" Visible="@IsVisible" HeaderText="@HeaderText" Field="@FieldName" IsPrimaryKey="@IsPrimaryKey"></BasicGridColumn>
    }
    else if (GridType == GridType.SfGrid)
    {
@*         <GridForeignColumn Visible="@IsVisible" HeaderText="@HeaderText" Field="@FieldName" IsPrimaryKey="@IsPrimaryKey" ForeignKeyValue="@ForeignKeyValue" ForeignDataSource="@ForeignDataSource"></GridForeignColumn> *@
        <GridForeignColumn TValue="TForeignDataItem" Visible="@IsVisible" HeaderText="@HeaderText" Field="@FieldName" IsPrimaryKey="@IsPrimaryKey" ForeignKeyField="@ForeignKeyField" ForeignKeyValue="@ForeignKeyValue">
            <Syncfusion.Blazor.Data.SfDataManager Url="@ForeignDataSourceUrl" CrossDomain="true" Adaptor="Adaptors.UrlAdaptor">
            </Syncfusion.Blazor.Data.SfDataManager>
        </GridForeignColumn>
    }
</div>
<style>
    /* styles for SfGrid */
    .e-grid .e-row .e-rowcell {
    padding-top: 2px;
    padding-bottom: 2px;
    }
</style>

@code 
{
    [CascadingParameter]
    public GridType GridType { get; set; }

    [Parameter]
    public IBaseGridModel<TGridItem> ViewModel { get; set; }

    [Parameter]
    public string HeaderText { get; set; }

    [Parameter]
    public string FieldName { get; set; }

    //public string Format { get; set; } = default!;

    [Parameter]
    public bool IsPrimaryKey { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Parameter]
    public string ForeignKeyField { get; set; }

    [Parameter]
    public string ForeignKeyValue { get; set; }

    [Parameter]
    public IEnumerable<TForeignDataItem> ForeignDataSource { get; set; }

    [Parameter]
    public string ForeignDataSourceUrl { get; set; }
}