@using System.Linq.Expressions
@typeparam TRowData

@code {

    [CascadingParameter]
    public required BasicGrid<TRowData> Parent { get; set; }

    [Parameter]
    public string HeaderText { get; set; } = default!;

    [Parameter]
    public string Field { get; set; }

    [Parameter]
    public string Format { get; set; }

    [Parameter]
    public bool IsPrimaryKey { get; set; }

    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public RenderFragment<TRowData> ChildContent { get; set; }


    private RenderFragment headerTemplate;
    private RenderFragment<TRowData> cellTemplate;

    internal RenderFragment HeaderTemplate
    {
        get
        {
            return headerTemplate ??= (builder =>
            {
                if (!Visible)
                    return;

                builder.OpenElement(0, "th");
                builder.AddAttribute(1, "scope", "col");
                builder.AddContent(2, HeaderText);
                builder.CloseElement();
            });
        }
    }

    internal RenderFragment<TRowData> CellTemplate
    {
        get
        {
            return cellTemplate ??= (rowData => builder =>
            {
                if (!Visible)
                {
                    if (IsPrimaryKey)
                    {
                        // Render a hidden input so the key value is available in the DOM
                        var property = typeof(TRowData).GetProperty(Field);
                        var cellValue = property?.GetValue(rowData);
                        builder.OpenElement(0, "input");
                        builder.AddAttribute(1, "type", "hidden");
                        builder.AddAttribute(2, "name", Field);
                        builder.AddAttribute(3, "value", cellValue);
                        builder.CloseElement();
                    }
                    return;
                }

                builder.OpenElement(0, "td");
                // Get property defined by "Field" on TRowData type
                var property2 = typeof(TRowData).GetProperty(Field);
                var cellValue2 = property2?.GetValue(rowData);
                var formattedValue = string.IsNullOrEmpty(Format) ? cellValue2?.ToString() : string.Format("{0:" + Format + "}", cellValue2);
                builder.AddContent(1, formattedValue);

                builder.CloseElement();
            });
        }
    }

    protected override void OnInitialized()
    {
        if (Parent == null)
            throw new ArgumentNullException(nameof(Parent), "BasicGridColumn must exist within a BasicGrid");

        base.OnInitialized(); 

        Parent.AddColumn(this);
    }
}
