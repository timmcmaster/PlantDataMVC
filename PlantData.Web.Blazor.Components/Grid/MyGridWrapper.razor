@using Microsoft.AspNetCore.Components.QuickGrid
@using PlantData.Web.Blazor.SharedComponents.Grid
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@typeparam TGridItem

<div class="container-lg">
    @if (@GridType == GridType.Basic)
    {
        <BasicGrid ViewModel="@ViewModel">
            <GridColumns>
                @foreach (var column in ViewModel.Columns)
                {
                    <BasicGridColumn TRowData="TGridItem" HeaderText="@column.HeaderText" FieldExpression="@column.FieldExpression" IsPrimaryKey="@column.IsPrimaryKey"></BasicGridColumn>
                }
            </GridColumns>
        </BasicGrid>
    }
    else if (GridType == GridType.QuickGrid)
    {
        <QuickGrid Items="@ViewModel.Items.AsQueryable()" TGridItem="TGridItem">
            @foreach (var column in ViewModel.Columns)
            {
                <PropertyColumn Title="@column.HeaderText" Property="@column.FieldExpression" Sortable="@ViewModel.Options.AllowSorting"></PropertyColumn>
            }

        </QuickGrid>
    }
    else if (GridType == GridType.SfGrid)
    {
        <SfGrid DataSource="@ViewModel.Items" 
        AllowPaging="@ViewModel.Options.AllowPaging" 
        AllowSorting="@ViewModel.Options.AllowSorting"
        Height="550" Width="800" 
        Toolbar="@ViewModel.Options.ToolbarItems">
            @*         <SfDataManager Adaptor="Adaptors.UrlAdaptor" 
                     Url="UrlDatasource" 
                     InsertUrl="Insert" 
                     UpdateUrl="Update" 
                     RemoveUrl="Delete">
        </SfDataManager>
 *@        <GridPageSettings PageSize="@ViewModel.Paging.PageSize" CurrentPage="@ViewModel.Paging.PageNumber"></GridPageSettings>
            <GridEditSettings AllowAdding="@ViewModel.Options.AllowAdd" AllowEditing="@ViewModel.Options.AllowEdit" AllowDeleting="@ViewModel.Options.AllowDelete" Mode="EditMode.Dialog"></GridEditSettings>
            <GridColumns>
                @foreach (var column in ViewModel.Columns)
                {
                    <GridColumn Field="@column.FieldName" HeaderText="@column.HeaderText" IsPrimaryKey="@column.IsPrimaryKey"></GridColumn>
                }
            </GridColumns>
    </SfGrid>
    }
</div>
<style>
    /* styles for QuickGrid */
 
    /* styles for SfGrid */
    .e-grid .e-row .e-rowcell {
    padding-top: 2px;
    padding-bottom: 2px;
    }
</style>

@code {
    [Parameter]
    public IBaseGridModel<TGridItem> ViewModel { get; set; }

    [Parameter]
    public GridType GridType { get; set; }
}
