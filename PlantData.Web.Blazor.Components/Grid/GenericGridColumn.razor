@using Microsoft.AspNetCore.Components.QuickGrid
@using PlantData.Web.Blazor.SharedComponents.Grid
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using System;
@using System.Linq.Expressions;
@using System.Reflection;

@typeparam TGridItem

<div class="container-lg">
    @if (DisplayAsCheckbox)
    {
        <GridColumn Visible="@IsVisible" HeaderText="@HeaderText" Field="@FieldName" Format="@Format" IsPrimaryKey="@IsPrimaryKey" DisplayAsCheckBox=@DisplayAsCheckbox EditType="Syncfusion.Blazor.Grids.EditType.BooleanEdit"></GridColumn>
    }
    else if (EditType.HasValue)
    {
        <GridColumn Visible="@IsVisible" HeaderText="@HeaderText" Field="@FieldName" Format="@Format" IsPrimaryKey="@IsPrimaryKey" EditType="@EditType.Value"/>
    }
    else
    {
        <GridColumn Visible="@IsVisible" HeaderText="@HeaderText" Field="@FieldName" Format="@Format" IsPrimaryKey="@IsPrimaryKey" />
    }
</div>
<style>
    /* styles for SfGrid */
    .e-grid .e-row .e-rowcell {
    padding-top: 2px;
    padding-bottom: 2px;
    }
</style>

@code {
    [Parameter]
    public IBaseGridModel<TGridItem> ViewModel { get; set; }

    [Parameter]
    public string HeaderText { get; set; }

    [Parameter]
    public string FieldName { get; set; }

    [Parameter]
    public string Format { get; set; } = default!;

    [Parameter]
    public bool IsPrimaryKey { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Parameter]
    public bool DisplayAsCheckbox { get; set; } = false;

    [Parameter]
    public EditType? EditType { get; set; }
}
