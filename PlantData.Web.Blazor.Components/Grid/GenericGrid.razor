@using Microsoft.AspNetCore.Components.QuickGrid
@using PlantData.Web.Blazor.SharedComponents.Grid
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@attribute [CascadingTypeParameter(nameof(TGridItem))]
@typeparam TGridItem

<div class="container-lg">
    @if (@GridType == GridType.Basic)
    {
        <BasicGrid Items="@ViewModel.Items" links="@ViewModel.Links" AllowAdd="@ViewModel.Options.AllowAdd" AllowEdit="@ViewModel.Options.AllowEdit" AllowDelete="@ViewModel.Options.AllowDelete" AllowPaging="@ViewModel.Options.AllowPaging">
            <GridColumns>
                @GenericGridColumns(@ViewModel.Items)
            </GridColumns>
        </BasicGrid>
    }
    else if (GridType == GridType.SfGrid)
    {
        <SfGrid DataSource="@ViewModel.Items"
                AllowPaging="@ViewModel.Options.AllowPaging"
                AllowSorting="@ViewModel.Options.AllowSorting"
                Height="550" Width="800"
                Toolbar="@ViewModel.Options.ToolbarItems">
            @*         <SfDataManager Adaptor="Adaptors.UrlAdaptor" 
                     Url="UrlDatasource" 
                     InsertUrl="Insert" 
                     UpdateUrl="Update" 
                     RemoveUrl="Delete">
        </SfDataManager>
 *@        <GridPageSettings PageSize="@ViewModel.Paging.PageSize" CurrentPage="@ViewModel.Paging.PageNumber"></GridPageSettings>
            <GridEditSettings AllowAdding="@ViewModel.Options.AllowAdd" AllowEditing="@ViewModel.Options.AllowEdit" AllowDeleting="@ViewModel.Options.AllowDelete" Mode="EditMode.Dialog"></GridEditSettings>
            <GridColumns>
                @GenericGridColumns(@ViewModel.Items)
            </GridColumns>
        </SfGrid>
    }
</div>
<style>
    /* styles for SfGrid */
    .e-grid .e-row .e-rowcell {
        padding-top: 2px;
        padding-bottom: 2px;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public IBaseGridModel<TGridItem> ViewModel { get; set; }

    [Parameter, EditorRequired]
    public GridType GridType { get; set; }

    [Parameter]
    public RenderFragment<IEnumerable<TGridItem>>? GenericGridColumns { get; set; } = default!; // Should contain all columns

}
