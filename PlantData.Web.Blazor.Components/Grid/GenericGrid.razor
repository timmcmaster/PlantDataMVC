@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data

@attribute [CascadingTypeParameter(nameof(TGridItem))]
@typeparam TGridItem

<div class="generic-grid-wrapper">
    <SfGrid @ref="_sfGrid" TValue="TGridItem" Query="@GridQuery" AllowPaging="@ViewModel.Options.AllowPaging"
            AllowSorting="@ViewModel.Options.AllowSorting"
            Toolbar="@ViewModel.Options.ToolbarItems">
        <SfDataManager Url="@ViewModel.UrlDataSource.Url"
                        InsertUrl="@ViewModel.UrlDataSource.InsertUrl"
                        UpdateUrl="@ViewModel.UrlDataSource.UpdateUrl"
                        RemoveUrl="@ViewModel.UrlDataSource.DeleteUrl"
                        Adaptor="Adaptors.UrlAdaptor">
        </SfDataManager>
        <GridPageSettings PageSize="@ViewModel.Paging.PageSize" CurrentPage="@ViewModel.Paging.PageNumber"></GridPageSettings>
        <GridEditSettings AllowAdding="@ViewModel.Options.AllowAdd" AllowEditing="@ViewModel.Options.AllowEdit" AllowDeleting="@ViewModel.Options.AllowDelete" Mode="EditMode.Dialog"></GridEditSettings>
        <GridEvents RowSelected="RowSelectHandler" TValue="TGridItem"></GridEvents>
        <GridColumns>
            @GenericGridColumns
        </GridColumns>
    </SfGrid>
</div> 


<style>
    .generic-grid-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .generic-grid-wrapper ::deep .e-grid {
            width: 100% !important;
            height: 100% !important;
        }

    /* styles for SfGrid */
    .e-grid .e-row .e-rowcell {
        padding-top: 2px;
        padding-bottom: 2px;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public IBaseGridModel<TGridItem> ViewModel { get; set; }

    [Parameter]
    public RenderFragment? GenericGridColumns { get; set; } = default!; // Should contain all columns

    [Parameter]
    public EventCallback<TGridItem?> OnRowSelected { get; set; }

    public Query GridQuery { get; set; }

    private SfGrid<TGridItem> _sfGrid;

    protected override void OnInitialized()
    {
        GridQuery = new Query().AddParams("allowPaging", ViewModel.Options.AllowPaging);
    }

    public async Task RowSelectHandler(RowSelectEventArgs<TGridItem> args)
    {
        if (OnRowSelected.HasDelegate)
        {
            TGridItem? selectedItem = default!;
            selectedItem = args.Data;
            if (selectedItem != null)
            {
                await OnRowSelected.InvokeAsync(selectedItem);
            }
        }
        
    }

    public async Task RefreshAsync()
    {
        if (_sfGrid != null)
        {
            await _sfGrid.Refresh();
        }
    }

    public async Task<IEnumerable<TGridItem>> GetCurrentViewRecordsAsync()
    {
        if (_sfGrid != null)
        {
            return await _sfGrid.GetCurrentViewRecordsAsync();
        }
        return Enumerable.Empty<TGridItem>();
    }
}
