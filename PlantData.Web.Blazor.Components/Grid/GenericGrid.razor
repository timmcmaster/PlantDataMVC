@using Microsoft.AspNetCore.Components.QuickGrid
@using PlantData.Web.Blazor.SharedComponents.Grid
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data

@attribute [CascadingTypeParameter(nameof(TGridItem))]
@typeparam TGridItem

<CascadingValue IsFixed="true" Value="@GridType">
    <div class="container-lg">
        @if (@GridType == GridType.Basic)
        {
            <BasicGrid TRowData="TGridItem" Links="@ViewModel.Links" AllowAdd="@ViewModel.Options.AllowAdd" AllowEdit="@ViewModel.Options.AllowEdit" AllowDelete="@ViewModel.Options.AllowDelete" AllowPaging="@ViewModel.Options.AllowPaging">
                <DataManager>
                    <BasicGridDataManager TRowData="TGridItem"
                                          UrlDataSource="@ViewModel.UrlDataSource"
                                          Paging="@ViewModel.Paging"
                                          Sorting="@ViewModel.Sorting"
                                          AllowPaging="@ViewModel.Options.AllowPaging" />
                </DataManager>
                <GridColumns>
                    @GenericGridColumns
                </GridColumns>
            </BasicGrid>
        }
        else if (GridType == GridType.SfGrid)
        {
            <SfGrid TValue="TGridItem" Query="@GridQuery" AllowPaging="@ViewModel.Options.AllowPaging"
                    AllowSorting="@ViewModel.Options.AllowSorting"
                    Height="550" Width="800"
                    Toolbar="@ViewModel.Options.ToolbarItems">
                <SfDataManager Url="@ViewModel.UrlDataSource.Url"
                               InsertUrl="@ViewModel.UrlDataSource.InsertUrl"
                               UpdateUrl="@ViewModel.UrlDataSource.UpdateUrl"
                               RemoveUrl="@ViewModel.UrlDataSource.DeleteUrl"
                               Adaptor="Adaptors.UrlAdaptor">
                </SfDataManager>
                <GridPageSettings PageSize="@ViewModel.Paging.PageSize" CurrentPage="@ViewModel.Paging.PageNumber"></GridPageSettings>
                <GridEditSettings AllowAdding="@ViewModel.Options.AllowAdd" AllowEditing="@ViewModel.Options.AllowEdit" AllowDeleting="@ViewModel.Options.AllowDelete" Mode="EditMode.Dialog"></GridEditSettings>
                <GridColumns>
                    @GenericGridColumns
                </GridColumns>
            </SfGrid>
        }
    </div>
</CascadingValue>


<style>
    /* styles for SfGrid */
    .e-grid .e-row .e-rowcell {
        padding-top: 2px;
        padding-bottom: 2px;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public IBaseGridModel<TGridItem> ViewModel { get; set; }

    [Parameter, EditorRequired]
    public GridType GridType { get; set; }

    [Parameter]
    public RenderFragment? GenericGridColumns { get; set; } = default!; // Should contain all columns

    public Query GridQuery { get; set; }

    protected override void OnInitialized()
    {
        GridQuery = new Query().AddParams("allowPaging", ViewModel.Options.AllowPaging);
    }
}
