@{
    Dictionary<string, object> HtmlAttribute = new Dictionary<string, object>() { { "class", "sidebar-menu" } };
}

<SfSidebar @HtmlAttributes="@HtmlAttribute" @EnableDock="true" @DockSize="@DockWidth" @Width="@Width" @Target="@TargetCss" @IsOpen="true", @Type="Auto">
    <ChildContent>
        <div class="main-menu">
            <div>
                <SfMenu id="dockMenu" Items="@ViewModel.Items" fields="menuFields" Orientation=Orientation.Vertical cssClass="dock-menu">
                    <MenuFieldSettings 
                        ItemId = "@ViewModel.Fields.ItemIdField"
                        Text = "@ViewModel.Fields.TextField"
                        ParentId = "@ViewModel.Fields.ParentIdField"
                        Url = "@ViewModel.Fields.UrlField"
                        IconCss = "@ViewModel.Fields.IconCssField"
                    ></MenuFieldSettings>
                </SfMenu>
            </div>
        </div>
    </ChildContent>
</SfSidebar>

@code
{
    [Parameter]
    public string TargetCss { get; set; }

    [Parameter]
    public string Width { get; set; }

    [Parameter]
    public string DockWidth { get; set; }

    [Parameter]
    public ISidebarMenuViewModel ViewModel { get; set; }
 }