@using StocktakeHeader = PlantDataMVC.Web.Models.ViewModels.StocktakeHeader

@model StocktakeHeaderGridViewModel
@{
    StocktakeHeader.StocktakeHeaderListViewModel sampleElement = new StocktakeHeader.StocktakeHeaderListViewModel();
    var dpParams = (new { @params = new { format = "dd/MM/yyyy" } });
}
<div class="container-lg">
    <ejs-grid id="StocktakeHeaderGrid"
              allowPaging="@Model.Options.AllowPaging"
              allowSorting="@Model.Options.AllowSorting"
              height="550" width="1000"
              toolbar="@Model.Options.ToolbarItems">
        <e-data-manager adaptor="UrlAdaptor"
                        url="@Url.Action("UrlDatasource", @PlantDataMvcAppControllers.StocktakeHeaderGrid, new { allowPaging = $"{Model.Options.AllowPaging}" })"
                        insertUrl="@Url.Action("Insert", @PlantDataMvcAppControllers.StocktakeHeaderGrid)"
                        updateUrl="@Url.Action("Update", @PlantDataMvcAppControllers.StocktakeHeaderGrid)"
                        removeUrl="@Url.Action("Delete", @PlantDataMvcAppControllers.StocktakeHeaderGrid)">
        </e-data-manager>
        <e-grid-pagesettings pageSize="@Model.PageSize" currentPage="@Model.PageNumber"></e-grid-pagesettings>
        <e-grid-editsettings allowAdding="@Model.Options.AllowAdd" allowEditing="@Model.Options.AllowEdit" allowDeleting="@Model.Options.AllowDelete"></e-grid-editsettings>
        <e-grid-columns>
            <e-grid-column field="@nameof(sampleElement.Id)" headerText="@Html.DisplayNameFor(x => sampleElement.Id)" visible="false" isPrimaryKey="true"></e-grid-column>
            <e-grid-column field="@nameof(sampleElement.Reference)" headerText="@Html.DisplayNameFor(x => sampleElement.Reference)"></e-grid-column>
            <e-grid-column field="@nameof(sampleElement.StocktakeDate)" headerText="@Html.DisplayNameFor(x => sampleElement.StocktakeDate)" type="date" format="dd/MM/yyyy" editType="datepickeredit" edit="dpParams"></e-grid-column>
        </e-grid-columns>
    </ejs-grid>
</div>
<style>
    .e-grid .e-row .e-rowcell {
        padding-top: 2px;
        padding-bottom: 2px;
    }
</style>