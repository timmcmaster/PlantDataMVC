@inject PlantDataMVC.Web.Services.IBarcodeLayoutLookupService layoutLookup

@model PlantDataMVC.Web.Models.ViewModels.Label.BarcodeLabelsViewModel
@{
    ViewBag.Title = "Barcode Labels";
    var labelLayouts = layoutLookup.GetData()
                                   .OrderByDescending(x => x.IsDefault)
                                   .ThenBy(x => x.LayoutName)
                                   .Select(x => new { LayoutName = x.LayoutName, LayoutDescription = x.LayoutDescription });
    var selectedLayout = labelLayouts.FirstOrDefault();
}
<h2>Barcode Labels</h2>
<div class="container-lg">
    <form asp-controller=@PlantDataMvcAppControllers.Label asp-action="BarcodesPrint">
        <fieldset>
            <legend>Barcode Labels</legend>

            <div class="row mb-3">
                <label asp-for="LayoutName" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    @Html.DropDownListFor(
                             Model => Model.LayoutName,
                             new SelectList(labelLayouts, nameof(selectedLayout.LayoutName), nameof(selectedLayout.LayoutDescription),selectedLayout),
                             "--Select Layout--",
                             new { @class = "form-select" })
                    <span asp-validation-for="LayoutName"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="BarcodeLabels"></label>
                <div class="child-table">
                    @await Component.InvokeAsync("BarcodeLabelGrid", new { barcodeLabels = Model.BarcodeLabels, gridOptions = Model.GridOptions })
                </div>
            </div>
            <p>
                <input type="submit" value="Save" />
            </p>
        </fieldset>
    </form>
</div>