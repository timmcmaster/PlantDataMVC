@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.ViewModels.PriceListType
@using System.ComponentModel

@attribute [Route(PlantDataRoutes.PriceListType)]
@inject IConfiguration configuration

<h2>PriceListType</h2>

<h2>PriceListType List</h2>
<p>This is a list of all PriceListTypes recorded</p>

<GenericGrid TGridItem="PriceListTypeGridModel" ViewModel="_viewModel">
    <GenericGridColumns>
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<PriceListTypeGridModel>(x => x.Id))" FieldName="@nameof(PriceListTypeGridModel.Id)" IsPrimaryKey="true" IsVisible="false" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<PriceListTypeGridModel>(x => x.Name))" FieldName="@nameof(PriceListTypeGridModel.Name)" />
    </GenericGridColumns>
</GenericGrid>


@code 
{
    private BaseGridModel<PriceListTypeGridModel> _viewModel;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<PriceListTypeGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, itemCount),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel(PlantDataRoutes.PriceListType),
            UrlDataSource = new GridUrlDataSourceModel(PlantDataBlazorAppControllers.PriceListTypeGrid),
        };
        _viewModel.Options.AllowSorting = true;
    }
}
