@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.ViewModels.Site

@attribute [Route(PlantDataRoutes.Site)]

@inject IConfiguration configuration

<div class="grid-header">
    <h2>Site List</h2>
    <p>This is a list of all Sites</p>
</div>
<div class="grid-container">
    <!-- Left Panel: Grid -->
    <div class="grid-panel">
        <GenericGrid GridType="@GridType" TGridItem=SiteGridModel ViewModel="_viewModel" OnRowSelected="RowSelectedHandler">
            <GenericGridColumns>
                <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SiteGridModel>(x => x.Id))" FieldName="@nameof(SiteGridModel.Id)" IsPrimaryKey="true" IsVisible="false" />
                <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SiteGridModel>(x => x.SiteName))" FieldName="@nameof(SiteGridModel.SiteName)" />
                <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SiteGridModel>(x => x.Suburb))" FieldName="@nameof(SiteGridModel.Suburb)" />
                <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SiteGridModel>(x => x.Latitude))" FieldName="@nameof(SiteGridModel.Latitude)" />
                <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SiteGridModel>(x => x.Longitude))" FieldName="@nameof(SiteGridModel.Longitude)" />
            </GenericGridColumns>
        </GenericGrid>
    </div>
    <!-- Right Panel: Details -->
    <div class="detail-panel">
        @if (_selectedItem != null)
        {
            <h3>Site Details</h3>
            <div class="detail-content">
                <p><strong>Site Name:</strong> @_selectedItem.SiteName</p>
                <p><strong>Suburb:</strong> @_selectedItem.Suburb</p>
                <p><strong>Latitude:</strong> @_selectedItem.Latitude</p>
                <p><strong>Longitude:</strong> @_selectedItem.Longitude</p>
                <!-- Add more details as needed -->
            </div>
        }
        else
        {
            <p class="text-muted">Select an item from the grid to view details</p>
        }
    </div>
    <div class="map-panel">
        <LeafletMap @ref="mapComponent" Latitude="@((double)(_selectedItem?.Latitude ?? 0))" Longitude="@((double)(_selectedItem?.Longitude ?? 0))" Zoom="10" ShowMarker="@(_selectedItem != null)" MarkerText="@_selectedItem?.SiteName" />
    </div>
</div>


@code 
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicHtmlViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BaseGridModel<SiteGridModel> _viewModel;
    private SiteGridModel? _selectedItem;
    private LeafletMap mapComponent;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<SiteGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, itemCount),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel(PlantDataRoutes.Site),
            UrlDataSource = new GridUrlDataSourceModel(PlantDataBlazorAppControllers.SiteGrid),
    };
        _viewModel.Options.AllowSorting = true;
    }

    private void RowSelectedHandler(SiteGridModel row)
    {
        _selectedItem = row;

    }

    private async Task UpdateMap()
    {
        if (mapComponent != null)
        {
            await mapComponent.UpdateMapLocationAsync(-33.00, 153.00, "Somewhere near Australia");
        }
    }

    private async Task DropPin()
    {
        if (mapComponent != null)
        {
            await mapComponent.AddMarkerAsync(0, 0, "Marker text");
        }
    }

}
