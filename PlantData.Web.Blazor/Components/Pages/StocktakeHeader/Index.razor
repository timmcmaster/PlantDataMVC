@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.ViewModels.StocktakeHeader
@using System.ComponentModel

@attribute [Route(PlantDataRoutes.StocktakeHeader)]
@inject IConfiguration configuration

<h2>StocktakeHeader</h2>

<h2>StocktakeHeader List</h2>
<p>This is a list of all StocktakeHeaders recorded</p>

<GenericGrid TGridItem="StocktakeHeaderGridModel" ViewModel="_viewModel">
    <GenericGridColumns>
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<StocktakeHeaderGridModel>(x => x.Id))" FieldName="@nameof(StocktakeHeaderGridModel.Id)" IsPrimaryKey="true" IsVisible="false" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<StocktakeHeaderGridModel>(x => x.Reference))" FieldName="@nameof(StocktakeHeaderGridModel.Reference)" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<StocktakeHeaderGridModel>(x => x.StocktakeDate))" FieldName="@nameof(StocktakeHeaderGridModel.StocktakeDate)" Format="dd/MM/yyyy" />
    </GenericGridColumns>
</GenericGrid>


@code 
{
    private BaseGridModel<StocktakeHeaderGridModel> _viewModel;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<StocktakeHeaderGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, itemCount),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel(PlantDataRoutes.StocktakeHeader),
            UrlDataSource = new GridUrlDataSourceModel(PlantDataBlazorAppControllers.StocktakeHeaderGrid),
        };
        _viewModel.Options.AllowSorting = true;
    }
}
