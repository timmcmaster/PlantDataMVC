@using System.ComponentModel
@using MediatR
@using Microsoft.Extensions.Configuration
@using Newtonsoft.Json
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.Features.Genus
@using PlantData.Web.Blazor.Features.Plant
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.EditModels.Label
@using PlantData.Web.Blazor.UIModels.ViewModels.Label
@using PlantDataMVC.Api.Models.DataModels

@attribute [Route(PlantDataRoutes.PlantLabel)]

@inject IConfiguration configuration
@inject IMediator mediator
@inject IJSRuntime JS

<h2>Plant Labels</h2>
<p>Select species and quantities to generate plant information labels</p>

<EditForm Model="_viewModel" OnValidSubmit="Submit" FormName="PlantLabelsForm">
    <DataAnnotationsValidator />
    
    <GenericGrid @ref="_grid" TGridItem=PlantLabelRequestGridModel ViewModel="_gridViewModel">
        <GenericGridColumns>
            <GenericGridForeignColumn TGridItem=PlantLabelRequestGridModel HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<PlantLabelRequestGridModel>(x => x.SpeciesBinomial))" FieldName="@nameof(PlantLabelRequestGridModel.SpeciesId)"
                                      TForeignDataItem=SpeciesDataModel ForeignKeyField="@_fcmSpecies.ForeignKeyField" ForeignKeyValue="@_fcmSpecies.ForeignKeyValue" ForeignDataSourceUrl="@_fcmSpecies.ForeignDataUrl" />
            <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<PlantLabelRequestGridModel>(x => x.LabelQuantity))" FieldName="@nameof(PlantLabelRequestGridModel.LabelQuantity)" />
        </GenericGridColumns>
    </GenericGrid>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Generate Plant Labels</span>
            }
        </button>
    </div>  

    <ValidationSummary />

</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">@successMessage</div>
}


@code 
{
    private PlantLabelsViewModel _viewModel;

    private BaseGridModel<PlantLabelRequestGridModel> _gridViewModel;
    private GenericGrid<PlantLabelRequestGridModel> _grid;

    private ForeignColumnModel<SpeciesDataModel> _fcmSpecies;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new PlantLabelsViewModel
        {
            PlantLabelRequests = new List<PlantLabelRequestGridModel>()
        };

        _gridViewModel = new BaseGridModel<PlantLabelRequestGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, itemCount),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel(PlantDataRoutes.PlantLabel),
            UrlDataSource = new GridUrlDataSourceModel(PlantDataBlazorAppControllers.PlantLabelRequestGrid),
        };
        _gridViewModel.Options.AllowSorting = false;
    
        // Define foreign column info for SpeciesId
        _fcmSpecies = new ForeignColumnModel<SpeciesDataModel>(
            foreignKeyField: x => nameof(x.Id),
            foreignKeyValue: x => nameof(x.SpeciesBinomial),
            GridUrlDataSourceModel.GetUrl(PlantDataBlazorAppControllers.PlantGrid, PlantDataBlazorAppControllers.DataRoutes.List)
        );

    }

    private async Task Submit()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        isProcessing = true;

        try
        {
            // Get grid data and convert ViewModel to EditModel
            var gridData = await _grid.GetCurrentViewRecordsAsync();

            var form = new PlantLabelsEditModel
            {
                Items = gridData.Select(x => new PlantLabelListEditModel
                {
                    SpeciesId = x.SpeciesId,
                    LabelQuantity = x.LabelQuantity
                })
                .ToList()
            };

            // HACK: Move this to the VM, rather than doing here
            var fileModel = await _viewModel.GetPdfLabelsReport(mediator, form);

            await JS.InvokeVoidAsync("openPdfInNewTab", fileModel.DataBase64, fileModel.Name);

        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating labels: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }


}