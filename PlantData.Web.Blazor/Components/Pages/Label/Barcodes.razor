@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.UIModels.EditModels.Label
@using PlantData.Web.Blazor.UIModels.ViewModels.Label
@using PlantData.Web.Blazor.Features.Labels
@using Syncfusion.Blazor.DropDowns

@attribute [Route(PlantDataRoutes.BarcodeLabel)]

@inject IBarcodeLayoutLookupService layoutLookup
@inject IConfiguration configuration

<h2>Barcode Labels</h2>
<SfDropDownList TValue="string" TItem="LayoutModel" Placeholder="Select a layout" DataSource="@_labelLayouts">
    <DropDownListFieldSettings Value="Name" Text="Description"></DropDownListFieldSettings>
</SfDropDownList>
<p></p>
<GenericGrid GridType="@GridType" TGridItem=BarcodeLabelRequestGridModel ViewModel="_gridViewModel">
    <GenericGridColumns>
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.ProductPriceId))" FieldName="@nameof(BarcodeLabelRequestGridModel.ProductPriceId)" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.ProductPriceText))" FieldName="@nameof(BarcodeLabelRequestGridModel.ProductPriceText)" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.LabelQuantity))" FieldName="@nameof(BarcodeLabelRequestGridModel.LabelQuantity)" />
    </GenericGridColumns>
</GenericGrid>

<div class="mt-3">
    <button class="btn btn-primary" @onclick="GenerateLabels" disabled="@isProcessing">
        @if (isProcessing)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Processing...</span>
        }
        else
        {
            <span>Generate Barcode Labels</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">@successMessage</div>
}

@code
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicHtmlViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BarcodeLabelsViewModel _viewModel;

    private BaseGridModel<BarcodeLabelRequestGridModel> _gridViewModel;

    private List<LayoutModel> _labelLayouts;
    private string _selectedLayoutName;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;


    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BarcodeLabelsViewModel
            {
                LayoutName = string.Empty,
                BarcodeLabelRequests = new List<BarcodeLabelRequestGridModel>()
            };

        _gridViewModel = new BaseGridModel<BarcodeLabelRequestGridModel>()
            {
                Options = GridOptionsModel.Default,
                Paging = new PagingModel(pageSize, pageNumber, itemCount),
                Sorting = new GridSortingModel(),
                Links = new GridLinksModel(PlantDataRoutes.SaleEvent),
                UrlDataSource = new GridUrlDataSourceModel(PlantDataMvcAppControllers.BarcodeLabelRequestGrid),
            };
        _gridViewModel.Options.AllowSorting = false;

        // Use await to properly handle async GetData() call
        var layoutData = await layoutLookup.GetData();
        _labelLayouts = layoutData
                            .OrderByDescending(x => x.IsDefault)
                            .ThenBy(x => x.LayoutName)
                            .Select(x => new LayoutModel { Name = x.LayoutName, Description = x.LayoutDescription })
                            .ToList();
        _selectedLayoutName = _labelLayouts.FirstOrDefault()?.Name;
    }

    private async Task GenerateLabels()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrEmpty(_selectedLayoutName))
        {
            errorMessage = "Please select a layout before generating labels";
            return;
        }

        isProcessing = true;

        try
        {
            // Get grid data and convert to form model
            var form = new BarcodeLabelsEditModel
            {
                LayoutName = _selectedLayoutName,
                Items = _viewModel.BarcodeLabelRequests
                    .Select(x => new BarcodeLabelListEditModel
                    {
                        ProductPriceId = x.ProductPriceId,
                        LabelQuantity = x.LabelQuantity
                    })
                    .ToList()
            };

            // 
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating labels: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
