@using MediatR
@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.Features.Labels
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.EditModels.Label
@using PlantData.Web.Blazor.UIModels.ViewModels.Label
@using PlantDataMVC.Api.Models.DataModels
@using Syncfusion.Blazor.DropDowns

@attribute [Route(PlantDataRoutes.BarcodeLabel)]

@inject IBarcodeLayoutLookupService layoutLookup
@inject IConfiguration configuration
@inject IMediator mediator
@inject IJSRuntime JS

<h2>Barcode Labels</h2>
<EditForm Model="_viewModel" OnValidSubmit="Submit" FormName="BarcodeLabelsForm">
    <DataAnnotationsValidator />

    <SfDropDownList TValue="string" TItem="LayoutModel" Placeholder="Select a layout" DataSource="@_labelLayouts" @bind-Value="_viewModel.LayoutName">
        <DropDownListFieldSettings Value="Name" Text="Description" />
    </SfDropDownList>

    <p></p>

    <GenericGrid @ref="_grid" GridType="@GridType" TGridItem=BarcodeLabelRequestGridModel ViewModel="_gridViewModel">
        <GenericGridColumns>
            <GenericGridForeignColumn TGridItem=BarcodeLabelRequestGridModel HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.ProductPriceId))" FieldName="@nameof(BarcodeLabelRequestGridModel.ProductPriceId)"
                                      TForeignDataItem=ProductPriceDataModel ForeignKeyField="@_fcmProductPrices.ForeignKeyField" ForeignKeyValue="@_fcmProductPrices.ForeignKeyValue" ForeignDataSourceUrl="@_fcmProductPrices.ForeignDataUrl" />
            <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.LabelQuantity))" FieldName="@nameof(BarcodeLabelRequestGridModel.LabelQuantity)" />
        </GenericGridColumns>
    </GenericGrid>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Generate Barcode Labels</span>
            }
        </button>
    </div>

    <ValidationSummary />
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">@successMessage</div>
}

@code {
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicHtmlViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BarcodeLabelsViewModel _viewModel;

    private BaseGridModel<BarcodeLabelRequestGridModel> _gridViewModel;
    private GenericGrid<BarcodeLabelRequestGridModel> _grid;

    private List<LayoutModel> _labelLayouts;

    private ForeignColumnModel<ProductPriceDataModel> _fcmProductPrices;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;


    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BarcodeLabelsViewModel
            {
                LayoutName = string.Empty,
                BarcodeLabelRequests = new List<BarcodeLabelRequestGridModel>()
            };

        _gridViewModel = new BaseGridModel<BarcodeLabelRequestGridModel>()
            {
                Options = GridOptionsModel.Default,
                Paging = new PagingModel(pageSize, pageNumber, itemCount),
                Sorting = new GridSortingModel(),
                Links = new GridLinksModel(PlantDataRoutes.SaleEvent),
                UrlDataSource = new GridUrlDataSourceModel(PlantDataBlazorAppControllers.BarcodeLabelRequestGrid),
            };
        _gridViewModel.Options.AllowSorting = false;

        // Load product prices for dropdown
        _fcmProductPrices = new ForeignColumnModel<ProductPriceDataModel>(
            foreignKeyField: x => nameof(x.Id),
            foreignKeyValue: x => nameof(x.ProductPriceText),
            GridUrlDataSourceModel.GetUrl(PlantDataBlazorAppControllers.ProductPriceGrid, PlantDataBlazorAppControllers.DataRoutes.List)
        );

        // Use await to properly handle async GetData() call
        var layoutData = await layoutLookup.GetData();
        _labelLayouts = layoutData
                            .OrderByDescending(x => x.IsDefault)
                            .ThenBy(x => x.LayoutName)
                            .Select(x => new LayoutModel { Name = x.LayoutName, Description = x.LayoutDescription })
                            .ToList();
        _viewModel.LayoutName = _labelLayouts.FirstOrDefault()?.Name;

    }

    private async Task Submit()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrEmpty(_viewModel.LayoutName))
        {
            errorMessage = "Please select a layout before generating labels";
            return;
        }

        isProcessing = true;

        try
        {
            // Get grid data and convert ViewModel to EditModel
            var gridData = await _grid.GetCurrentViewRecordsAsync();

            var form = new BarcodeLabelsEditModel
            {
                LayoutName = _viewModel.LayoutName,
                Items = gridData.Select(x => new BarcodeLabelListEditModel
                {
                    ProductPriceId = x.ProductPriceId,
                    LabelQuantity = x.LabelQuantity
                })
                .ToList()
            };

            // HACK: Move this to the VM, rather than doing here
            var fileModel = await GetPdfLabelsReport(form);
                        
            await JS.InvokeVoidAsync("openPdfInNewTab", fileModel.DataBase64, fileModel.Name);

        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating labels: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<FileModel> GetPdfLabelsReport(BarcodeLabelsEditModel form)
    {
        // Logic to generate or retrieve the PDF labels report.

        var result = await mediator.Send(form);

        var reportBytes = Convert.FromBase64String(result);

        var fileModel = new FileModel()
        {
            Name = $"BarcodeLabels-{DateTime.Now:yyyyMMdd_HHmm}.pdf",
            ContentType = "application/pdf",
            Data = reportBytes,
            DataBase64 = result
        };

        return fileModel;
    }
}
