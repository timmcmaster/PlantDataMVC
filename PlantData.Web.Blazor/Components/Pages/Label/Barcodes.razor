@code
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicHtmlViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BaseGridModel<BarcodeLabelRequestGridModel> _viewModel;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<BarcodeLabelRequestGridModel>()
            {
                Options = GridOptionsModel.Default,
                Paging = new PagingModel(pageSize, pageNumber, itemCount),
                Sorting = new GridSortingModel(),
                Links = new GridLinksModel(PlantDataRoutes.SaleEvent),
                UrlDataSource = new GridUrlDataSourceModel(PlantDataMvcAppControllers.BarcodeLabelRequestGrid),
            };
        _viewModel.Options.AllowSorting = false;
    }
}
