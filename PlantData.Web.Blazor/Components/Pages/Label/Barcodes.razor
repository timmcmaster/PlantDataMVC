<SfDropDownList TValue="string" TItem="LayoutModel" Placeholder="Select a layout" DataSource="@_labelLayouts">
    <DropDownListFieldSettings Value="Name" Text="Description"></DropDownListFieldSettings>
</SfDropDownList>
<p></p>
<GenericGrid GridType="@GridType" TGridItem=BarcodeLabelRequestGridModel ViewModel="_viewModel">
    <GenericGridColumns>
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.ProductPriceId))" FieldName="@nameof(BarcodeLabelRequestGridModel.ProductPriceId)" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.ProductPriceText))" FieldName="@nameof(BarcodeLabelRequestGridModel.ProductPriceText)" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<BarcodeLabelRequestGridModel>(x => x.LabelQuantity))" FieldName="@nameof(BarcodeLabelRequestGridModel.LabelQuantity)" />
    </GenericGridColumns>
</GenericGrid>


@code
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicHtmlViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BaseGridModel<BarcodeLabelRequestGridModel> _viewModel;

    private List<LayoutModel> _labelLayouts;
    private LayoutModel _selectedLayout;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<BarcodeLabelRequestGridModel>()
            {
                Options = GridOptionsModel.Default,
                Paging = new PagingModel(pageSize, pageNumber, itemCount),
                Sorting = new GridSortingModel(),
                Links = new GridLinksModel(PlantDataRoutes.SaleEvent),
                UrlDataSource = new GridUrlDataSourceModel(PlantDataMvcAppControllers.BarcodeLabelRequestGrid),
            };
        _viewModel.Options.AllowSorting = false;

        // Use await to properly handle async GetData() call
        var layoutData = await layoutLookup.GetData();
        _labelLayouts = layoutData
                            .OrderByDescending(x => x.IsDefault)
                            .ThenBy(x => x.LayoutName)
                            .Select(x => new LayoutModel { Name = x.LayoutName, Description = x.LayoutDescription })
                            .ToList();
        _selectedLayout = _labelLayouts.FirstOrDefault();
    }
}
