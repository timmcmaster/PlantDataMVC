@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.ViewModels.SeedBatch
@using PlantDataMVC.Api.Models.DataModels

@attribute [Route(PlantDataRoutes.SeedBatch)]

@inject IConfiguration configuration


<div class="grid-header">
    <h2>Seed Batch List</h2>
    <p>This is a list of all Seed Batches</p>
</div>
<div class="grid-container">
    <!-- Left Panel: Grid -->
    <div class="grid-panel">
        <GenericGrid GridType="@GridType" TGridItem=SeedBatchGridModel ViewModel="_viewModel" OnRowSelected="RowSelectedHandler">
        <GenericGridColumns>
            <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SeedBatchGridModel>(x => x.Id))" FieldName="@nameof(SeedBatchGridModel.Id)" IsPrimaryKey="true" IsVisible="false" />
            <GenericGridForeignColumn TGridItem=SeedBatchGridModel HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SeedBatchGridModel>(x => x.SpeciesBinomial))" FieldName="@nameof(SeedBatchGridModel.SpeciesId)"
                                      TForeignDataItem=SpeciesDataModel ForeignKeyField="@_fcmSpecies.ForeignKeyField" ForeignKeyValue="@_fcmSpecies.ForeignKeyValue" ForeignDataSourceUrl="@_fcmSpecies.ForeignDataUrl" />
            <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SeedBatchGridModel>(x => x.DateCollected))" FieldName="@nameof(SeedBatchGridModel.DateCollected)" Format="dd/MM/yyyy" />
            <GenericGridForeignColumn TGridItem=SeedBatchGridModel HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SeedBatchGridModel>(x => x.SiteName))" FieldName="@nameof(SeedBatchGridModel.SiteId)"
                                      TForeignDataItem=SiteDataModel ForeignKeyField="@_fcmSite.ForeignKeyField" ForeignKeyValue="@_fcmSite.ForeignKeyValue" ForeignDataSourceUrl="@_fcmSite.ForeignDataUrl" />
            <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<SeedBatchGridModel>(x => x.Location))" FieldName="@nameof(SeedBatchGridModel.Location)" />
        </GenericGridColumns>
    </GenericGrid>
    </div>
    <!-- Right Panel: Details -->
    <div class="detail-panel">
        @if (_selectedItem != null)
        {
            <h3>Seed Batch Details</h3>
            <div class="detail-content">
                <p><strong>Binomial:</strong> @_selectedItem.SpeciesBinomial</p>
                <p><strong>Date Collected:</strong> @_selectedItem.DateCollected</p>
                <p><strong>Site Name:</strong> @_selectedItem.SiteName</p>
                <p><strong>Location:</strong> @_selectedItem.Location</p>
                <p><strong>Notes:</strong> @_selectedItem.Notes</p>
                <!-- Add more details as needed -->
            </div>
        }
        else
        {
            <p class="text-muted">Select an item from the grid to view details</p>
        }
    </div>
</div>


@code 
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicHtmlViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BaseGridModel<SeedBatchGridModel> _viewModel;

    private ForeignColumnModel<SiteDataModel> _fcmSite;
    private ForeignColumnModel<SpeciesDataModel> _fcmSpecies;
    private SeedBatchGridModel? _selectedItem;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<SeedBatchGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, itemCount),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel(PlantDataRoutes.SeedBatch),
            UrlDataSource = new GridUrlDataSourceModel(PlantDataBlazorAppControllers.SeedBatchGrid),
    };
        _viewModel.Options.AllowSorting = true;

        // Define foreign column info for SpeciesId 
        _fcmSpecies = new ForeignColumnModel<SpeciesDataModel>(
            foreignKeyField: x => nameof(x.Id),
            foreignKeyValue: x => nameof(x.SpeciesBinomial),
            GridUrlDataSourceModel.GetUrl(PlantDataBlazorAppControllers.PlantGrid, PlantDataBlazorAppControllers.DataRoutes.List)
        );

        // Define foreign column info for SiteId
        _fcmSite = new ForeignColumnModel<SiteDataModel>(
            foreignKeyField: x => nameof(x.Id),
            foreignKeyValue: x => nameof(x.SiteName),
            GridUrlDataSourceModel.GetUrl(PlantDataBlazorAppControllers.SiteGrid, PlantDataBlazorAppControllers.DataRoutes.List)
        );
    }

    private void RowSelectedHandler(SeedBatchGridModel row)
    {
        _selectedItem = row;
    }
}
