@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.ViewModels.Genus
@using System.ComponentModel

@page "/genus"
@inject IConfiguration configuration

<h2>Genus</h2>

@* @model ListViewModelStatic<PlantData.Web.Mvc.Models.ViewModels.Genus.GenusListViewModel>
@{
    ViewBag.Title = "Index";
} *@
<h2>Genus List</h2>
<p>This is a list of all genuses recorded</p>

<GenericGrid GridType="@GridType" TGridItem="GenusGridModel" ViewModel="_viewModel">
    <GenericGridColumns>
        <GenericGridColumn GridType="@GridType" HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<GenusGridModel>(x => x.Id))" FieldName="@nameof(GenusGridModel.Id)" IsPrimaryKey="true" />
        <GenericGridColumn GridType="@GridType" HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<GenusGridModel>(x => x.LatinName))" FieldName="@nameof(GenusGridModel.LatinName)" />
    </GenericGridColumns>
</GenericGrid>


@code 
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicMvcViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BaseGridModel<GenusGridModel> _viewModel;

    protected override async Task OnInitializedAsync()
    {
        var genusList = new List<string>() { "Abutilon", "Acacia", "Acmella", "Acmena", "Akania", "Aleogyne", "Allocasuarina", "Alloxylon", "Alphitonia", "Alpinia", "Alyxia", 
                                             "Ammannia", "Amphibromus", "Anadenanthera", "Angophora", "Anigozanthos", "Anisomeles", "Anopterus", "Anthocercis", "Anthosachne", "Aotus", "Aphanopetalum",
                                             "Aphelia", "Aphyllanthes", "Aponogeton", "Aptosimum", "Arthropodium", "Astelia", "Asterolasia", "Astroloma", "Atriplex", "Austromyrtus",
                                             "Banksia", "Brachychiton", "Callistemon", "Chrysocephalum", "Deeringia", "Eucalyptus", "Leptospermum", "Melaleuca", "Synoum", "Syncarpus", "Syzygium" };

        int id = 1;
        var items = new List<GenusGridModel>();

        foreach (var genus in genusList)
        {
            items.Add(new GenusGridModel() { Id = id, LatinName = genus });
            id++;
        };

        var columns = new List<BaseGridColumnModel<GenusGridModel>>()
        {
            new BaseGridColumnModel<GenusGridModel>() {  FieldName = nameof(GenusGridModel.Id), HeaderText = ReflectionExtensions.GetPropertyDisplayName<GenusGridModel>(x => x.Id), IsPrimaryKey = true },
            new BaseGridColumnModel<GenusGridModel>() {  FieldName = nameof(GenusGridModel.LatinName), HeaderText = ReflectionExtensions.GetPropertyDisplayName<GenusGridModel>(x => x.LatinName) }
        };
        var pageSize = 10;
        var pageNumber = 1;

        _viewModel = new BaseGridModel<GenusGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, genusList.Count),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel("genus"),
            Items = items.Skip((pageNumber-1)*pageSize).Take(pageSize),
            Columns = columns
        };
        _viewModel.Options.AllowSorting = false;
    }
}
