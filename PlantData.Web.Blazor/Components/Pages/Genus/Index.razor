@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using System.ComponentModel
@page "/genus"

<h2>Genus</h2>

@* @model ListViewModelStatic<PlantData.Web.Mvc.Models.ViewModels.Genus.GenusListViewModel>
@{
    ViewBag.Title = "Index";
} *@
<h2>Genus List</h2>
<p>This is a list of all genuses recorded</p>

@* @await Component.InvokeAsync("GenusGrid", new { model = Model, gridOptions = Model.GridOptions })
 *@
<BasicGrid ViewModel="_viewModel">
     <BasicGridColumn TRowData="GenusGridModel" HeaderText="Id" FieldExpression="x => x.Id" IsPrimaryKey="true"></BasicGridColumn>
     <BasicGridColumn TRowData="GenusGridModel" HeaderText="Latin Name" FieldExpression="x => x.LatinName"></BasicGridColumn>
</BasicGrid>


 <PrettyGrid ViewModel="_viewModel"></PrettyGrid>

@code 
{
    private BaseGridModel<GenusGridModel> _viewModel;

    protected override async Task OnInitializedAsync()
    {
        var genusList = new List<string>() { "Abutilon", "Acacia", "Acmella", "Acmena", "Akania", "Aleogyne", "Allocasuarina", "Alloxylon", "Alphitonia", "Alpinia", "Alyxia", 
                                             "Ammannia", "Amphibromus", "Anadenanthera", "Angophora", "Anigozanthos", "Anisomeles", "Anopterus", "Anthocercis", "Anthosachne", "Aotus", "Aphanopetalum",
                                             "Aphelia", "Aphyllanthes", "Aponogeton", "Aptosimum", "Arthropodium", "Astelia", "Asterolasia", "Astroloma", "Atriplex", "Austromyrtus",
                                             "Banksia", "Brachychiton", "Callistemon", "Chrysocephalum", "Deeringia", "Eucalyptus", "Leptospermum", "Melaleuca", "Synoum", "Syncarpus", "Syzygium" };

        int id = 1;
        var items = new List<GenusGridModel>();

        foreach (var genus in genusList)
        {
            items.Add(new GenusGridModel() { Id = id, LatinName = genus });
            id++;
        };

        var propertyColumns = new List<string>() { nameof(GenusGridModel.Id), nameof(GenusGridModel.LatinName) };
        var pageSize = 10;
        var pageNumber = 1;

        _viewModel = new BaseGridModel<GenusGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, genusList.Count),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel("genus"),
            Items = items.Skip((pageNumber-1)*pageSize).Take(pageSize),
            PropertyColumns = propertyColumns
        };
        _viewModel.Options.AllowSorting = false;
    }

    public class GenusGridModel
    {
        [DisplayName("Id")]
        public int Id { get; set; }

        [DisplayName("Latin Name")]
        public string LatinName { get; set; }
    }
}
