@using Microsoft.Extensions.Configuration
@using PlantData.Web.Blazor.DisplayHelpers
@using PlantData.Web.Blazor.SharedComponents.Grid
@using PlantData.Web.Blazor.SharedComponents.Paging
@using PlantData.Web.Blazor.UIModels.Constants
@using PlantData.Web.Blazor.UIModels.ViewModels.ProductType
@using System.ComponentModel

@attribute [Route(PlantDataRoutes.ProductType)]
@inject IConfiguration configuration

<h2>ProductType</h2>

<h2>ProductType List</h2>
<p>This is a list of all ProductTypees recorded</p>

<GenericGrid GridType="@GridType" TGridItem="ProductTypeGridModel" ViewModel="_viewModel">
    <GenericGridColumns>
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<ProductTypeGridModel>(x => x.Id))" FieldName="@nameof(ProductTypeGridModel.Id)" IsPrimaryKey="true" IsVisible="false" />
        <GenericGridColumn HeaderText="@(ReflectionExtensions.GetPropertyDisplayName<ProductTypeGridModel>(x => x.Name))" FieldName="@nameof(ProductTypeGridModel.Name)" />
    </GenericGridColumns>
</GenericGrid>


@code 
{
    public GridType GridType => Convert.ToBoolean(configuration["WebUI:UseBasicMvcViews"]) == true ? GridType.Basic : GridType.SfGrid;

    private BaseGridModel<ProductTypeGridModel> _viewModel;

    protected override async Task OnInitializedAsync()
    {
        var pageSize = 20;
        var pageNumber = 1;
        var itemCount = 100; // Hack: should be from url

        _viewModel = new BaseGridModel<ProductTypeGridModel>()
        {
            Options = GridOptionsModel.Default,
            Paging = new PagingModel(pageSize, pageNumber, itemCount),
            Sorting = new GridSortingModel(),
            Links = new GridLinksModel(PlantDataRoutes.ProductType),
            UrlDataSource = new GridUrlDataSourceModel(PlantDataMvcAppControllers.ProductTypeGrid),
        };
        _viewModel.Options.AllowSorting = false;
    }
}
