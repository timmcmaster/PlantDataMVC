@using PlantData.Web.Blazor.SharedComponents.Layout
@inherits LayoutComponentBase

@* @inject ISidebarMenuViewModel menuViewModel *@

<div class="page">
@*     <div class="sidebar">
        <NavMenu />
    </div>
 *@

    <main class="main-content">
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

    <div class="sidebar">
        <SidebarMenu ViewModel="menuViewModel" DockWidth="50px" Width="220px" TargetCss=".main-content" />
    </div>

</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
