@using PlantData.Web.Blazor.UIModels.ViewModels
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Inputs

@inherits LayoutComponentBase

@inject ISidebarMenuViewModel menuViewModel

<div class="page">
    <div id="wrapper">
        <div class="toolbar">
            @*Initialize the Toolbar component*@
            <SfToolbar ID="menuToolbar">
                 <ToolbarEvents Clicked="@Toggle"></ToolbarEvents>
                 <ToolbarItems>
                    <ToolbarItem PrefixIcon="e-icons e-menu" TooltipText="Menu"></ToolbarItem>
                    <ToolbarItem>
                        <Template>
                            <div class='e-folder'>
                                <div class='e-folder-name'>Blazor Plant Data Application</div>
                            </div>
                        </Template>
                    </ToolbarItem>
                </ToolbarItems>
            </SfToolbar>
        </div>

        @*Initialize the Sidebar menu component*@
        <SidebarMenu ViewModel="menuViewModel" DockWidth="50px" Width="220px" TargetCss=".main-content" Docked="SidebarDocked" />

        @*main-content declaration*@
        <div id="main-text" class="main-content" height="800px">
            <div class="sidebar-content">
                <div class="content px-4">
                    @Body
                </div>
            </div>
        </div>

        <div id="footer">
            A web page by Tim McMaster.
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    public bool SidebarDocked = false;

    // Specifies the event handler for Clicked event in Toolbar component.
    public void Toggle(ClickEventArgs args)
    {
        if (args.Item.TooltipText == "Menu")
        {
            SidebarDocked = !SidebarDocked;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

}
