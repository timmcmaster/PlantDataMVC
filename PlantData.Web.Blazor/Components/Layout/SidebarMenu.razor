@inject ISidebarMenuViewModel vm

@{
    Dictionary<string, object> HtmlAttribute = new Dictionary<string, object>() { { "class", "sidebar-menu" } };
}

<SfSidebar @HtmlAttributes="@HtmlAttribute" @EnableDock="true" @DockSize="@vm.DockWidth" @Width="@vm.Width" @Target="@vm.TargetCss" @IsOpen="true", @Type="Auto">
    <ChildContent>
        <div class="main-menu">
            <div>
                <SfMenu id="dockMenu" Items="@vm.Menu.MenuItems" fields="menuFields" Orientation=Orientation.Vertical cssClass="dock-menu">
                    <MenuFieldSettings 
                        ItemId = "@vm.Menu.MenuFields.ItemIdField"
                        Text = "@vm.Menu.MenuFields.TextField"
                        ParentId = "@vm.Menu.MenuFields.ParentIdField"
                        Url = "@vm.Menu.MenuFields.UrlField"
                        IconCss = "@vm.Menu.MenuFields.IconCssField"
                    ></MenuFieldSettings>
                </SfMenu>
            </div>
        </div>
    </ChildContent>
</SfSidebar>

@code
{
    protected override async Task OnInitializedAsync()
    {
        await vm.InitialiseAsync().ConfigureAwait(false);
    }
}